# Copy to .env and fill in locally. .env is gitignored - never commit real tokens.

# --- Snowflake account -------------------------------------------------------
SNOWFLAKE_ACCOUNT=pndvhar-pt70809
SNOWFLAKE_HOST=pndvhar-pt70809.snowflakecomputing.com
BBC_DATABASE=BBC_OS
BBC_APP_WAREHOUSE=BBC_APP_WH

# snow CLI connection (from ~/.snowflake/connections.toml) used by `bbc` admin and test commands
BBC_CONNECTION=pndvhar-pt70809

# --- Service identities (programmatic access tokens, role-restricted) --------
# Connectors: INSERT into RAW only
BBC_INGEST_USER=BBC_INGEST_SVC
BBC_INGEST_PAT=
# Engine worker + dispatcher: API engine procedures only
BBC_ENGINE_USER=BBC_ENGINE_SVC
BBC_ENGINE_PAT=
# Agent invocation: agent tools only (Cortex Agents use this user's DEFAULT role)
BBC_AGENT_USER=BBC_AGENT_SVC
BBC_AGENT_PAT=

# --- Demo persona identities (approvals are attributed to these users) -------
BBC_QUALITY_USER=BBC_DEMO_QUALITY
BBC_QUALITY_PAT=
BBC_SALES_USER=BBC_DEMO_SALES
BBC_SALES_PAT=
BBC_FINANCE_USER=BBC_DEMO_FINANCE
BBC_FINANCE_PAT=
BBC_AUDITOR_USER=BBC_DEMO_AUDITOR
BBC_AUDITOR_PAT=
BBC_GOVADMIN_USER=BBC_DEMO_GOVADMIN
BBC_GOVADMIN_PAT=

# --- Connectors ----------------------------------------------------------------
# IoT webhook (packages/connector-iot). The device platform - here the simulator,
# `bbc sim telemetry` - signs each batch with this shared secret.
BBC_IOT_HMAC_SECRET=
BBC_IOT_PORT=8787
BBC_IOT_CONNECTOR_ID=iot-webhook
# snowflake (default: API.INGEST_BATCH as BBC_INGEST_SVC) or memory (local dry runs)
BBC_IOT_SINK=snowflake
BBC_DEAD_LETTER_DIR=.artifacts/dead-letter

# SAP S/4 connector (packages/connector-sap-s4); defaults point at apps/mock-s4
BBC_SAP_URL=http://127.0.0.1:4004/sap/opu/odata/sap
BBC_SAP_USER=BBC_CONNECTOR
BBC_SAP_PASSWORD=mock
BBC_SAP_KEY_MAP=.artifacts/sim/reference/sap_key_map.json
# Carrier / TMS connector (packages/connector-carrier); defaults point at apps/mock-tms
BBC_TMS_URL=http://127.0.0.1:4005
BBC_TMS_TOKEN=mock-tms-token
# Local world (apps/dev-stack): memory (default) or snowflake
BBC_STACK_SINK=memory

# --- Control tower (apps/control-tower) ---------------------------------------
# live (default): every page reads Snowflake as the signed-in persona's own PAT
# fixture: replay contracts/tapes (nothing reaches Snowflake; a banner says so)
BBC_API_MODE=live
BBC_FIXTURE_TAPES=S-A,S-B,S-C
# Signs the session cookie; random per start when unset (sessions end on restart)
BBC_CT_SESSION_SECRET=
# Required at sign-in when set; without it sign-in is accepted from 127.0.0.1 only
BBC_CT_ACCESS_CODE=
BBC_CT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
BBC_CT_POLL_MS=4000

# --- Engine (packages/engine): lifecycle worker + dispatcher ---------------------
BBC_ENGINE_ID=engine-1
BBC_ENGINE_WORKERS=2
BBC_ENGINE_LEASE_S=120
BBC_AGENT_TIMEOUT_MS=300000
# Dispatcher: mutations leased per NEXT_ACTIONS call, and their lease
BBC_DISPATCH_BATCH=10
BBC_DISPATCH_LEASE_S=300
# Loopback live-trace relay; the control tower proxies it with this token
BBC_ENGINE_RELAY_PORT=8791
BBC_ENGINE_RELAY_TOKEN=
BBC_ENGINE_RELAY_URL=http://127.0.0.1:8791
