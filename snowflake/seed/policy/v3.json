    { "name": "PREDICTED_SL_AT_ETA_DAYS", "version": "1", "canonical": true, "unit": "days", "grain": "case_lot_destination", "owner_role": "BBC_QUALITY_MGR", "staleness_limit_min": 120 },
    { "name": "SPEC_MARGIN_DAYS", "version": "1", "canonical": true, "unit": "days", "grain": "case_lot_destination", "owner_role": "BBC_QUALITY_MGR", "staleness_limit_min": 120 },
    { "name": "EXCESS_LIFE_SHARE", "version": "1", "canonical": true, "unit": "share", "grain": "lot_holder", "owner_role": "BBC_QUALITY_MGR", "staleness_limit_min": 120, "definition_hash": "e42f3b185c36d0db0906023b42ed293e8574abbe4dc960919d8afc68e42e7ae9" },
    { "name": "PLANNED_VALUE_USD", "version": "1", "canonical": true, "unit": "USD", "grain": "case_lot", "owner_role": "BBC_FINANCE_MGR", "staleness_limit_min": null, "definition_hash": "64b9404b28daad153e51eadc6e85a3421a8f12ec4b7a3f4a90b6f043ea0255b6" },
