# Normalize text to LF everywhere (scripts, SQL and JSON hash identically across OSes)
* text=auto eol=lf

# Binary documents - never convert line endings (PDF xref byte offsets must stay exact)
*.pdf  binary
*.pptx binary
*.png  binary
*.jpg  binary

# Generated fixture tapes (packages/bbc-api: corepack pnpm --filter @blueberrychain/bbc-api tapes)
contracts/tapes/*.json linguist-generated=true -diff
