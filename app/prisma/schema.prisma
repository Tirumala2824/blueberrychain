// =====================================================================
// BlueberryChain OS - Prisma schema
//
// Prisma owns APPLICATION STATE ONLY, in Snowflake Postgres:
// chat threads, messages, the tool-call timeline, the approval queue
// mirror and a metric-provenance mirror for fast UI reads.
//
// Prisma has NO Snowflake connector and deliberately does not touch the
// BLUEBERRY_CHAIN supply chain tables or the semantic view. All agent
// invocation and all metric reads go through the Snowflake Node driver
// (see src/lib/snowflake.ts) so the semantic view stays the single
// source of truth for every number.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A persona is only a label on a thread. There are no per-persona
/// screens or modules: everyone uses the same chat surface and the same
/// Supervisor agent.
enum Persona {
  RANCH_MANAGER
  LOGISTICS
  QUALITY
  FINANCE
  SALES
  EXECUTIVE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ToolCallStatus {
  SUCCESS
  ERROR
  PENDING_APPROVAL
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

model Thread {
  id                String    @id @default(cuid())
  /// Snowflake Cortex thread id, so conversation context survives reloads
  snowflakeThreadId String?   @map("snowflake_thread_id")
  /// Value passed as P_THREAD_ID to every tool, linking the Snowflake audit trail
  auditThreadId     String    @unique @map("audit_thread_id")
  title             String    @default("New conversation")
  persona           Persona   @default(LOGISTICS)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  messages  Message[]
  toolCalls ToolCall[]
  approvals Approval[]

  @@index([updatedAt])
  @@map("threads")
}

model Message {
  id       String      @id @default(cuid())
  threadId String      @map("thread_id")
  role     MessageRole
  /// Rendered assistant text or the raw user prompt
  content  String      @db.Text
  /// Orchestration model that produced an assistant message
  model    String?
  /// Milliseconds the agent run took
  latencyMs Int?       @map("latency_ms")
  /// Ordered action steps for the timeline (Json array of TimelineStep)
  steps         Json?  @map("steps")
  /// Vega-Lite chart specs with inline data
  charts        Json?  @map("charts")
  /// Downloadable documents (invoice / credit note) - pdf base64, title, summary
  documents     Json?  @map("documents")
  /// Suggested follow-up queries (clickable chips)
  suggestedQueries Json? @map("suggested_queries")
  createdAt DateTime   @default(now()) @map("created_at")

  thread    Thread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]

  @@index([threadId, createdAt])
  @@map("messages")
}

/// One row per tool the agent invoked, so the UI can show the autonomous
/// chain step by step instead of just the final prose.
model ToolCall {
  id         String         @id @default(cuid())
  threadId   String         @map("thread_id")
  messageId  String?        @map("message_id")
  /// Which specialist agent owned the tool, e.g. COLD_CHAIN_AGENT
  agentName  String?        @map("agent_name")
  toolName   String         @map("tool_name")
  status     ToolCallStatus @default(SUCCESS)
  /// Snowflake AUDIT.DECISION_LOG.DECISION_ID
  decisionId String?        @map("decision_id")
  entityType String?        @map("entity_type")
  entityId   String?        @map("entity_id")
  /// Arguments the agent passed
  input      Json?
  /// Tool return value
  output     Json?
  sequence   Int            @default(0)
  createdAt  DateTime       @default(now()) @map("created_at")

  thread  Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  metrics MetricProvenance[]

  @@index([threadId, sequence])
  @@map("tool_calls")
}

/// The metric values a tool actually read from the semantic view at
/// decision time. Mirrored from AUDIT.DECISION_LOG.METRIC_SNAPSHOT so
/// the UI can render a provenance chip beside every number without a
/// round trip to Snowflake.
model MetricProvenance {
  id           String   @id @default(cuid())
  toolCallId   String   @map("tool_call_id")
  metricName   String   @map("metric_name")
  metricValue  String   @map("metric_value")
  /// Always the governed semantic view FQN
  semanticView String   @default("BLUEBERRY_CHAIN.SEMANTIC.ORGANIC_BLUEBERRY_CHAIN") @map("semantic_view")
  readAt       DateTime @default(now()) @map("read_at")

  toolCall ToolCall @relation(fields: [toolCallId], references: [id], onDelete: Cascade)

  @@index([toolCallId])
  @@index([metricName])
  @@map("metric_provenance")
}

/// Mirror of AUDIT.APPROVAL_QUEUE. Snowflake remains authoritative; this
/// exists so the chat UI can render approval cards and poll cheaply.
model Approval {
  id                String         @id @default(cuid())
  threadId          String?        @map("thread_id")
  /// Snowflake AUDIT.APPROVAL_QUEUE.APPROVAL_ID, e.g. APR-000001
  approvalId        String         @unique @map("approval_id")
  agentName         String?        @map("agent_name")
  toolName          String         @map("tool_name")
  status            ApprovalStatus @default(PENDING)
  estimatedValueUsd Decimal?       @map("estimated_value_usd") @db.Decimal(14, 2)
  thresholdUsd      Decimal?       @map("threshold_usd") @db.Decimal(14, 2)
  payload           Json?
  metricSnapshot    Json?          @map("metric_snapshot")
  decisionNote      String?        @map("decision_note")
  requestedAt       DateTime       @default(now()) @map("requested_at")
  decidedAt         DateTime?      @map("decided_at")
  decidedBy         String?        @map("decided_by")

  thread Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@map("approvals")
}
