#
# BlueberryChain OS - environment template
# Copy to .env.local (Next.js runtime) and put DATABASE_URL in .env (Prisma CLI).
# Never commit the real files - both are gitignored.
#

# --- Snowflake Postgres (Prisma: app state only) ---
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require"

# --- Snowflake (agents + semantic view, via snowflake-sdk) ---
SNOWFLAKE_ACCOUNT=<org-account>
SNOWFLAKE_USER=<user>
SNOWFLAKE_PASSWORD=<password-or-PAT>
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=BBC_WH
SNOWFLAKE_DATABASE=BLUEBERRY_CHAIN
SNOWFLAKE_SCHEMA=TOOLS
BBC_SUPERVISOR_AGENT=BLUEBERRY_CHAIN.TOOLS.SUPERVISOR_AGENT
