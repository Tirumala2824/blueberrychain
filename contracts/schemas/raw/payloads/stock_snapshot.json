{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/raw/payloads/stock_snapshot.json",
  "title": "Stock snapshot",
  "description": "Stock by plant / batch / status at a point in time (SAP material stock, mapped). Source: SAP.",
  "type": "object",
  "required": [
    "site_id",
    "lot_id",
    "product_id",
    "kg",
    "stock_status",
    "snapshot_at"
  ],
  "additionalProperties": false,
  "properties": {
    "site_id": {
      "$ref": "../../common.json#/$defs/external_id"
    },
    "lot_id": {
      "$ref": "../../common.json#/$defs/external_id"
    },
    "product_id": {
      "$ref": "../../common.json#/$defs/external_id"
    },
    "kg": {
      "$ref": "../../common.json#/$defs/kg"
    },
    "stock_status": {
      "enum": [
        "UNRESTRICTED",
        "ALLOCATED",
        "BLOCKED",
        "QUALITY",
        "IN_TRANSIT"
      ]
    },
    "snapshot_at": {
      "$ref": "../../common.json#/$defs/timestamp"
    }
  }
}
