{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/evidence_pack.json",
  "title": "Evidence pack",
  "description": "Sealed snapshot of every fact a decision used, as knowable at as_of (data received <= as_of). Immutable once sealed; content_hash is recorded in the ledger. REPLAY_EVIDENCE rebuilds it and must reproduce the hash.",
  "type": "object",
  "required": ["pack_id", "case_id", "decision_point", "revision", "as_of", "sealed_at",
               "param_versions", "shipment", "lots", "custody_timeline", "affected_order_lines",
               "candidate_inventory", "candidate_destinations", "documents", "data_gaps",
               "deadline_inputs", "content_hash"],
  "additionalProperties": false,
  "properties": {
    "pack_id": { "$ref": "common.json#/$defs/pack_id" },
    "case_id": { "$ref": "common.json#/$defs/case_id" },
    "decision_point": { "$ref": "common.json#/$defs/decision_point" },
    "revision": { "type": "integer", "minimum": 1 },
    "as_of": { "$ref": "common.json#/$defs/timestamp" },
    "sealed_at": { "$ref": "common.json#/$defs/timestamp" },
    "param_versions": { "$ref": "common.json#/$defs/param_versions" },

    "shipment": {
      "type": "object",
      "required": ["shipment_id", "carrier_party_id", "origin_site_id", "destination_site_id",
                   "state_at_as_of", "eta_p50_at", "eta_p90_at"],
      "additionalProperties": false,
      "properties": {
        "shipment_id": { "$ref": "common.json#/$defs/external_id" },
        "carrier_party_id": { "$ref": "common.json#/$defs/external_id" },
        "reefer_device_id": { "$ref": "common.json#/$defs/external_id" },
        "origin_site_id": { "$ref": "common.json#/$defs/external_id" },
        "destination_site_id": { "$ref": "common.json#/$defs/external_id" },
        "bol_setpoint_c": { "oneOf": [{ "$ref": "common.json#/$defs/celsius" }, { "type": "null" }] },
        "state_at_as_of": { "enum": ["PLANNED", "LOADING", "IN_TRANSIT", "AT_DOCK", "DELIVERED", "REJECTED"] },
        "next_junction_site_id": { "oneOf": [{ "$ref": "common.json#/$defs/external_id" }, { "type": "null" }] },
        "eta_p50_at": { "$ref": "common.json#/$defs/timestamp" },
        "eta_p90_at": { "$ref": "common.json#/$defs/timestamp" },
        "reefer_state": {
          "description": "The reefer unit's latest reading: is a fault still active?",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["as_of", "alarms"],
              "additionalProperties": false,
              "properties": {
                "as_of": { "$ref": "common.json#/$defs/timestamp" },
                "mode": { "type": ["string", "null"] },
                "alarms": { "type": "array", "items": { "type": "string" } },
                "supply_air_c": { "oneOf": [{ "$ref": "common.json#/$defs/celsius" }, { "type": "null" }] },
                "return_air_c": { "oneOf": [{ "$ref": "common.json#/$defs/celsius" }, { "type": "null" }] },
                "setpoint_c": { "oneOf": [{ "$ref": "common.json#/$defs/celsius" }, { "type": "null" }] },
                "ambient_c": { "oneOf": [{ "$ref": "common.json#/$defs/celsius" }, { "type": "null" }] }
              }
            }
          ]
        },
        "evidence_id": { "$ref": "common.json#/$defs/evidence_id" }
      }
    },

    "lots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lot_id", "product_id", "organic", "kg", "planned_value_usd", "grower_party_id",
                     "harvest_at", "values", "custody_exposure", "proxy_air_only"],
        "additionalProperties": false,
        "properties": {
          "lot_id": { "$ref": "common.json#/$defs/external_id" },
          "product_id": { "$ref": "common.json#/$defs/external_id" },
          "organic": { "type": "boolean" },
          "kg": { "$ref": "common.json#/$defs/kg" },
          "planned_value_usd": { "$ref": "common.json#/$defs/usd" },
          "grower_party_id": { "$ref": "common.json#/$defs/external_id" },
          "harvest_at": { "$ref": "common.json#/$defs/timestamp" },
          "primary_probe_device_id": { "oneOf": [{ "$ref": "common.json#/$defs/external_id" }, { "type": "null" }] },
          "proxy_air_only": { "type": "boolean", "description": "True when no pulp probe exists and reefer air is used as a flagged proxy." },
          "last_pulp_c": { "oneOf": [{ "$ref": "common.json#/$defs/celsius" }, { "type": "null" }], "description": "Pulp temperature at the last reading: where the outcome simulation starts." },
          "last_reading_at": { "oneOf": [{ "$ref": "common.json#/$defs/timestamp" }, { "type": "null" }] },
          "food_safety_flag": { "type": "boolean", "description": "A GOV.HARD_LIMITS limit was exceeded (the assessment computes it): only hold, inspect or dispose remain." },
          "model_validity": { "enum": ["IN_RANGE", "EXTRAPOLATING", "UNCALIBRATED"], "description": "Whether the shelf-life model is valid for this lot's thermal history." },
          "sigma_days": { "type": "number", "minimum": 0, "description": "Standard deviation of the remaining-shelf-life estimate (calibration, else the product prior)." },
          "values": {
            "type": "array",
            "description": "Canonical metric values for this lot (frozen). Must include REMAINING_SHELF_LIFE_DAYS, MONITORING_COVERAGE_PCT, TEMPERATURE_COMPLIANCE_PCT, VALUE_AT_RISK_USD.",
            "items": { "$ref": "common.json#/$defs/value" }
          },
          "custody_exposure": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["holder_party_id", "holder_type", "excess_life_share", "thermal_exposure_deg_h", "breach_min"],
              "additionalProperties": false,
              "properties": {
                "holder_party_id": { "$ref": "common.json#/$defs/external_id" },
                "holder_type": { "$ref": "common.json#/$defs/holder_type" },
                "excess_life_share": { "oneOf": [{ "$ref": "common.json#/$defs/share" }, { "type": "null" }] },
                "thermal_exposure_deg_h": { "type": "number", "minimum": 0 },
                "breach_min": { "type": "number", "minimum": 0 },
                "evidence_id": { "$ref": "common.json#/$defs/evidence_id" }
              }
            }
          }
        }
      }
    },

    "custody_timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["party_id", "holder_type", "from_at"],
        "additionalProperties": false,
        "properties": {
          "party_id": { "$ref": "common.json#/$defs/external_id" },
          "holder_type": { "$ref": "common.json#/$defs/holder_type" },
          "site_id": { "oneOf": [{ "$ref": "common.json#/$defs/external_id" }, { "type": "null" }] },
          "from_at": { "$ref": "common.json#/$defs/timestamp" },
          "to_at": { "oneOf": [{ "$ref": "common.json#/$defs/timestamp" }, { "type": "null" }] },
          "evidence_id": { "$ref": "common.json#/$defs/evidence_id" }
        }
      }
    },

    "affected_order_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order_line_id", "customer_party_id", "customer_tier", "product_id", "kg",
                     "price_usd_per_kg", "requested_delivery_at", "ship_to_site_id",
                     "min_shelf_life_days_at_receipt"],
        "additionalProperties": false,
        "properties": {
          "order_line_id": { "$ref": "common.json#/$defs/external_id" },
          "customer_party_id": { "$ref": "common.json#/$defs/external_id" },
          "customer_tier": { "$ref": "common.json#/$defs/customer_tier" },
          "product_id": { "$ref": "common.json#/$defs/external_id" },
          "organic_required": { "type": "boolean" },
          "kg": { "$ref": "common.json#/$defs/kg" },
          "price_usd_per_kg": { "$ref": "common.json#/$defs/usd_per_kg" },
          "requested_delivery_at": { "$ref": "common.json#/$defs/timestamp" },
          "ship_to_site_id": { "$ref": "common.json#/$defs/external_id" },
          "min_shelf_life_days_at_receipt": { "$ref": "common.json#/$defs/days" },
          "max_arrival_pulp_c": { "oneOf": [{ "$ref": "common.json#/$defs/celsius" }, { "type": "null" }] },
          "assigned_lot_id": { "oneOf": [{ "$ref": "common.json#/$defs/external_id" }, { "type": "null" }] },
          "penalty_terms": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "otif_penalty_pct": { "type": "number", "minimum": 0, "maximum": 100 },
              "rejection_penalty_usd_per_kg": { "$ref": "common.json#/$defs/usd_per_kg" },
              "late_penalty_usd_per_day": { "$ref": "common.json#/$defs/usd" }
            }
          },
          "evidence_id": { "$ref": "common.json#/$defs/evidence_id" }
        }
      }
    },

    "candidate_inventory": {
      "type": "array",
      "description": "Replacement supply (quality-adjusted ATP) usable for affected lines.",
      "items": {
        "type": "object",
        "required": ["lot_id", "site_id", "product_id", "organic", "kg_available",
                     "remaining_shelf_life_days", "snapshot_at"],
        "additionalProperties": false,
        "properties": {
          "lot_id": { "$ref": "common.json#/$defs/external_id" },
          "site_id": { "$ref": "common.json#/$defs/external_id" },
          "product_id": { "$ref": "common.json#/$defs/external_id" },
          "organic": { "type": "boolean" },
          "kg_available": { "$ref": "common.json#/$defs/kg" },
          "remaining_shelf_life_days": { "$ref": "common.json#/$defs/days" },
          "snapshot_at": { "$ref": "common.json#/$defs/timestamp" },
          "evidence_id": { "$ref": "common.json#/$defs/evidence_id" }
        }
      }
    },

    "candidate_destinations": {
      "type": "array",
      "description": "Sites the generator may route to - agents cannot add destinations outside this list.",
      "items": {
        "type": "object",
        "required": ["site_id", "party_id", "channel", "price_usd_per_kg", "transit_h_p50",
                     "transit_h_p90", "min_shelf_life_days_at_receipt"],
        "additionalProperties": false,
        "properties": {
          "site_id": { "$ref": "common.json#/$defs/external_id" },
          "party_id": { "$ref": "common.json#/$defs/external_id" },
          "channel": { "$ref": "common.json#/$defs/sales_channel" },
          "customer_tier": { "oneOf": [{ "$ref": "common.json#/$defs/customer_tier" }, { "type": "null" }] },
          "price_usd_per_kg": { "$ref": "common.json#/$defs/usd_per_kg" },
          "transit_h_p50": { "$ref": "common.json#/$defs/hours" },
          "transit_h_p90": { "$ref": "common.json#/$defs/hours" },
          "min_shelf_life_days_at_receipt": { "$ref": "common.json#/$defs/days" },
          "capacity_kg": { "oneOf": [{ "$ref": "common.json#/$defs/kg" }, { "type": "null" }] },
          "max_arrival_pulp_c": { "oneOf": [{ "$ref": "common.json#/$defs/celsius" }, { "type": "null" }], "description": "The receiver's maximum pulp temperature at receipt (null = none)." },
          "freight_usd": { "oneOf": [{ "$ref": "common.json#/$defs/usd" }, { "type": "null" }], "description": "Incremental freight of the diversion from the current position." },
          "evidence_id": { "$ref": "common.json#/$defs/evidence_id" }
        }
      }
    },

    "inspection_sites": {
      "type": "array",
      "description": "Own facilities reachable for a QC hold (the INSPECT option), with the diversion's transit and freight.",
      "items": {
        "type": "object",
        "required": ["site_id", "transit_h_p50", "transit_h_p90"],
        "additionalProperties": false,
        "properties": {
          "site_id": { "$ref": "common.json#/$defs/external_id" },
          "transit_h_p50": { "$ref": "common.json#/$defs/hours" },
          "transit_h_p90": { "$ref": "common.json#/$defs/hours" },
          "freight_usd": { "oneOf": [{ "$ref": "common.json#/$defs/usd" }, { "type": "null" }] },
          "evidence_id": { "$ref": "common.json#/$defs/evidence_id" }
        }
      }
    },

    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "doc_type", "sha256", "received_at", "claims"],
        "additionalProperties": false,
        "properties": {
          "doc_id": { "$ref": "common.json#/$defs/external_id" },
          "doc_type": { "$ref": "common.json#/$defs/doc_type" },
          "sha256": { "$ref": "common.json#/$defs/sha256" },
          "received_at": { "$ref": "common.json#/$defs/timestamp" },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim_key", "value"],
              "additionalProperties": false,
              "properties": {
                "claim_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "value": { "type": ["number", "string", "boolean", "null"] },
                "unit": { "type": ["string", "null"] },
                "claimed_at": { "oneOf": [{ "$ref": "common.json#/$defs/timestamp" }, { "type": "null" }] },
                "consistency": {
                  "type": "object",
                  "required": ["verdict"],
                  "additionalProperties": false,
                  "properties": {
                    "verdict": { "$ref": "common.json#/$defs/consistency_verdict" },
                    "sensor_value": { "type": ["number", "null"] },
                    "delta": { "type": ["number", "null"] },
                    "rule_id": { "type": ["string", "null"] }
                  }
                },
                "evidence_id": { "$ref": "common.json#/$defs/evidence_id" }
              }
            }
          }
        }
      }
    },

    "data_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["device_id", "from_at", "to_at", "minutes"],
        "additionalProperties": false,
        "properties": {
          "device_id": { "$ref": "common.json#/$defs/external_id" },
          "from_at": { "$ref": "common.json#/$defs/timestamp" },
          "to_at": { "$ref": "common.json#/$defs/timestamp" },
          "minutes": { "type": "number", "minimum": 0 }
        }
      }
    },

    "deadline_inputs": {
      "type": "object",
      "required": ["windows"],
      "additionalProperties": false,
      "properties": {
        "windows": {
          "type": "array",
          "description": "When each kind of option stops being feasible (e.g. re-route junction passed).",
          "items": {
            "type": "object",
            "required": ["kind", "closes_at"],
            "additionalProperties": false,
            "properties": {
              "kind": { "$ref": "common.json#/$defs/disposition" },
              "site_id": { "oneOf": [{ "$ref": "common.json#/$defs/external_id" }, { "type": "null" }] },
              "closes_at": { "$ref": "common.json#/$defs/timestamp" }
            }
          }
        }
      }
    },

    "content_hash": { "$ref": "common.json#/$defs/sha256" }
  }
}
