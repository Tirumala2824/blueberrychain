{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/api/agent_trace_event.json",
  "title": "Agent trace event",
  "description": "One normalized event of a Cortex Agent run, as the engine parsed it from the agent's SSE stream. Streamed live to the control tower (unrecorded) and recorded through API.END_AGENT_RUN. Agent text is untrusted output: shown, never executed.",
  "type": "object",
  "required": ["run_id", "seq", "at", "kind"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "$ref": "../common.json#/$defs/run_id" },
    "seq": { "type": "integer", "minimum": 0 },
    "at": { "$ref": "../common.json#/$defs/timestamp" },
    "kind": { "enum": ["STATUS", "THINKING", "TEXT", "TOOL_USE", "TOOL_RESULT", "ERROR", "DONE", "OTHER"] },
    "text": { "type": "string", "maxLength": 20000 },
    "tool": {
      "type": "object",
      "required": ["name", "tool_use_id"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "tool_use_id": { "type": "string", "maxLength": 128 }
      }
    },
    "tool_result": {
      "type": "object",
      "required": ["tool_use_id", "status", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "tool_use_id": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 64 },
        "evidence_ids": { "type": "array", "items": { "$ref": "../common.json#/$defs/evidence_id" }, "maxItems": 500 }
      }
    },
    "error": { "$ref": "../common.json#/$defs/error" },
    "raw_type": { "type": "string", "maxLength": 128, "description": "The provider's SSE event name, kept for OTHER events." }
  }
}
