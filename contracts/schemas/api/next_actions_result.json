{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/api/next_actions_result.json",
  "title": "NEXT_ACTIONS result",
  "description": "API.NEXT_ACTIONS(dispatcher_id, max_actions, lease_s) (83_gateway.sql): lease AUTHORIZED mutations (they become PREPARED). STOPPED while an emergency stop is in force. Each intent is the full stored mutation intent, including its idempotency_key.",
  "oneOf": [
    {
      "$ref": "refusal.json"
    },
    {
      "type": "object",
      "required": [
        "status",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "OK",
            "STOPPED"
          ]
        },
        "actions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "mutation_id",
              "attempt",
              "intent"
            ],
            "additionalProperties": false,
            "properties": {
              "mutation_id": {
                "$ref": "../common.json#/$defs/mutation_id"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "intent": {
                "$ref": "../mutation_intent.json"
              }
            }
          }
        }
      }
    }
  ]
}
