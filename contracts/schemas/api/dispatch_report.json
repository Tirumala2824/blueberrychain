{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/api/dispatch_report.json",
  "title": "Dispatch report",
  "description": "The REPORT argument of API.ACK_MUTATION(mutation_id, report): what the dispatcher observed at the target. VERIFIED = observed_after matches expected_after; ABORTED_PRECONDITION = observed_before did not match expected_before (nothing was written); RETRY = the target's state is unknown after a timeout (the dispatcher never resends blind).",
  "type": "object",
  "required": ["outcome", "dispatcher_id", "attempt", "external_ref", "observed_before", "observed_after", "target_status",
               "target_response", "error", "started_at", "finished_at"],
  "additionalProperties": false,
  "properties": {
    "outcome": { "enum": ["VERIFIED", "FAILED", "ABORTED_PRECONDITION", "RETRY"] },
    "dispatcher_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt": { "type": "integer", "minimum": 1 },
    "external_ref": { "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "null" }] },
    "observed_before": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
    "observed_after": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
    "target_status": { "enum": ["UNKNOWN", "APPLIED", "FAILED", null] },
    "target_response": {},
    "error": { "oneOf": [{ "$ref": "../common.json#/$defs/error" }, { "type": "null" }] },
    "started_at": { "$ref": "../common.json#/$defs/timestamp" },
    "finished_at": { "$ref": "../common.json#/$defs/timestamp" }
  }
}
