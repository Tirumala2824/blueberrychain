{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/api/tape.json",
  "title": "Fixture tape",
  "description": "A recorded walk through one case, replayed by the control tower's fixture mode (BBC_API_MODE=fixture) with no business logic: frames of read-model snapshots, and recorded responses (per persona) that may move the tape to another frame. A call with no recording is refused (FIXTURE_NO_RECORDING), and a read with no recording behaves as not granted to that identity. Synthetic tapes use the design's illustrative numbers; recorded tapes come from a live BBC_OS. Nothing in a tape is a decision.",
  "type": "object",
  "required": ["tape", "title", "provenance", "description", "personas", "frames", "responses", "analyst", "agent_traces"],
  "additionalProperties": false,
  "properties": {
    "tape": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,31}$" },
    "title": { "type": "string", "maxLength": 200 },
    "provenance": { "type": "string", "pattern": "^(SYNTHETIC \\(design numbers\\)|LIVE BBC_OS .+)$" },
    "description": { "type": "string", "maxLength": 4000 },
    "personas": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/persona" },
      "additionalProperties": {
        "type": "object",
        "required": ["user", "role"],
        "additionalProperties": false,
        "properties": {
          "user": { "type": "string", "pattern": "^[A-Z][A-Z0-9_$]{0,254}$" },
          "role": { "$ref": "../common.json#/$defs/persona_role" }
        }
      }
    },
    "frames": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["label", "inbox", "cases"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "maxLength": 200 },
          "inbox": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/persona" },
            "additionalProperties": { "type": "array", "items": { "$ref": "inbox_row.json" } }
          },
          "cases": {
            "type": "object",
            "propertyNames": { "$ref": "../common.json#/$defs/case_id" },
            "additionalProperties": {
              "type": "object",
              "required": ["view", "viewers"],
              "additionalProperties": false,
              "properties": {
                "view": { "$ref": "case_view.json", "description": "The snapshot; its viewer is replaced per persona." },
                "viewers": {
                  "type": "object",
                  "propertyNames": { "$ref": "#/$defs/persona" },
                  "additionalProperties": { "$ref": "case_view.json#/$defs/viewer" }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["call", "persona", "at_frames", "match", "result", "advance_to_frame"],
        "additionalProperties": false,
        "properties": {
          "call": { "enum": ["ACTIVE_POLICY", "DECIDE_APPROVAL", "REVERSE_DECISION", "EMERGENCY_STOP", "VERIFY_LEDGER", "REPLAY_EVIDENCE", "EXPORT_EVIDENCE_PACK"] },
          "persona": { "$ref": "#/$defs/persona" },
          "at_frames": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1, "uniqueItems": true },
          "match": { "type": "object", "description": "Argument name -> value; every listed argument must deep-equal the call's." },
          "result": { "type": "object", "description": "Validated against the call's result schema by the tape tests." },
          "advance_to_frame": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
        }
      }
    },
    "analyst": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "answer": { "$ref": "analyst_answer.json" }
        }
      }
    },
    "agent_traces": {
      "type": "object",
      "propertyNames": { "$ref": "../common.json#/$defs/run_id" },
      "additionalProperties": {
        "type": "array", "maxItems": 2000,
        "items": {
          "type": "object",
          "required": ["delay_ms", "event"],
          "additionalProperties": false,
          "properties": {
            "delay_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
            "event": { "$ref": "agent_trace_event.json" }
          }
        }
      }
    }
  },
  "$defs": {
    "persona": { "enum": ["quality", "sales", "finance", "auditor", "govadmin"] }
  }
}
