{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/api/replay_result.json",
  "title": "REPLAY_EVIDENCE result",
  "description": "API.REPLAY_EVIDENCE(pack_id): rebuilds the pack as of its as_of from append-only RAW (received_at <= as_of) and the recorded reference versions, then compares content hashes.",
  "oneOf": [
    { "$ref": "refusal.json" },
    {
      "type": "object",
      "required": ["status", "pack_id", "as_of", "original_hash", "replayed_hash", "equal", "diff", "replayed_at"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "OK" },
        "pack_id": { "$ref": "../common.json#/$defs/pack_id" },
        "as_of": { "$ref": "../common.json#/$defs/timestamp" },
        "original_hash": { "$ref": "../common.json#/$defs/sha256" },
        "replayed_hash": { "$ref": "../common.json#/$defs/sha256" },
        "equal": { "type": "boolean" },
        "diff": {
          "type": "array", "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["path", "original", "replayed"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "maxLength": 500 },
              "original": {},
              "replayed": {}
            }
          }
        },
        "replayed_at": { "$ref": "../common.json#/$defs/timestamp" }
      }
    }
  ]
}
