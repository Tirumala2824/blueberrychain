{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/tools/request_evidence.json",
  "title": "REQUEST_EVIDENCE input",
  "description": "M1 - the only operational write an agent can trigger: a governed REQUEST_EVIDENCE mutation (policy-evaluated, deduplicated, at most 3 per case per type).",
  "type": "object",
  "required": [
    "run_id",
    "case_id",
    "request"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "$ref": "../common.json#/$defs/run_id"
    },
    "case_id": {
      "$ref": "../common.json#/$defs/case_id"
    },
    "request": {
      "type": "object",
      "required": [
        "evidence_type",
        "from_party_id",
        "reason",
        "needed_by_ts"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_type": {
          "$ref": "../common.json#/$defs/evidence_type"
        },
        "from_party_id": {
          "$ref": "../common.json#/$defs/external_id"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "needed_by_ts": {
          "$ref": "../common.json#/$defs/timestamp"
        }
      }
    }
  }
}
