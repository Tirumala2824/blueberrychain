{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/tools/get_party_context.json",
  "title": "GET_PARTY_CONTEXT input",
  "description": "R4 - customer / counterparty context. The party must be related to the case; aspects are allow-listed per agent.",
  "type": "object",
  "required": [
    "run_id",
    "case_id",
    "party_id",
    "aspects"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "$ref": "../common.json#/$defs/run_id"
    },
    "case_id": {
      "$ref": "../common.json#/$defs/case_id"
    },
    "party_id": {
      "$ref": "../common.json#/$defs/external_id"
    },
    "aspects": {
      "type": "array",
      "items": {
        "enum": [
          "PROFILE",
          "SPECS",
          "CONTRACT_TERMS",
          "CLAUSE_TEXT",
          "PENALTIES",
          "ACCOUNT_NOTES",
          "CLAIM_HISTORY",
          "RECENT_INCIDENTS"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
