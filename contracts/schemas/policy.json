{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueberrychain.dev/schemas/policy.json",
  "title": "Policy document",
  "description": "A complete, versioned policy (GOV). Drafted as data, validated against this schema, activated only through API.ACTIVATE_POLICY (ledgered).",
  "type": "object",
  "required": [
    "policy_version",
    "description",
    "parameters",
    "decision_rights",
    "router_rules",
    "hard_limits",
    "autonomy_thresholds",
    "action_types",
    "model_registry",
    "metric_registry"
  ],
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "parameters": {
      "type": "object",
      "required": [
        "autonomy_ceiling",
        "shadow_mode",
        "fallback_enabled",
        "dispatch_enabled",
        "approval_buffer_min",
        "min_acceptance_probability",
        "risk_aversion_lambda",
        "tier_a_weight_kappa_usd_per_kg",
        "near_tie_margin_pct",
        "near_tie_margin_usd",
        "high_exposure_usd",
        "detection_window_min",
        "consistency_tolerance_c",
        "fault_persistence_prior",
        "failure_to_mitigate_factor",
        "p_liab_by_finding",
        "montecarlo_samples",
        "staleness_limit_min",
        "snapshot_staleness_limit_h",
        "min_evidence_coverage_pct",
        "settlement_band_pct",
        "agent_call_budget"
      ],
      "additionalProperties": false,
      "properties": {
        "autonomy_ceiling": {
          "$ref": "common.json#/$defs/autonomy_level"
        },
        "shadow_mode": {
          "type": "boolean"
        },
        "fallback_enabled": {
          "type": "boolean"
        },
        "dispatch_enabled": {
          "type": "boolean"
        },
        "approval_buffer_min": {
          "type": "integer",
          "minimum": 0
        },
        "min_acceptance_probability": {
          "$ref": "common.json#/$defs/probability"
        },
        "risk_aversion_lambda": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tier_a_weight_kappa_usd_per_kg": {
          "type": "number",
          "minimum": 0
        },
        "near_tie_margin_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "near_tie_margin_usd": {
          "$ref": "common.json#/$defs/usd"
        },
        "high_exposure_usd": {
          "$ref": "common.json#/$defs/usd"
        },
        "detection_window_min": {
          "type": "integer",
          "minimum": 1
        },
        "consistency_tolerance_c": {
          "type": "number",
          "minimum": 0
        },
        "fault_persistence_prior": {
          "$ref": "common.json#/$defs/probability"
        },
        "failure_to_mitigate_factor": {
          "$ref": "common.json#/$defs/probability"
        },
        "p_liab_by_finding": {
          "type": "object",
          "required": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "ATTRIBUTION_ONLY"
          ],
          "additionalProperties": false,
          "properties": {
            "HIGH": {
              "$ref": "common.json#/$defs/probability"
            },
            "MEDIUM": {
              "$ref": "common.json#/$defs/probability"
            },
            "LOW": {
              "$ref": "common.json#/$defs/probability"
            },
            "ATTRIBUTION_ONLY": {
              "$ref": "common.json#/$defs/probability"
            }
          },
          "description": "P(liability) by causation-finding confidence; ATTRIBUTION_ONLY is used when no finding exists or confidence is LOW."
        },
        "montecarlo_samples": {
          "type": "integer",
          "minimum": 100,
          "maximum": 20000
        },
        "staleness_limit_min": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_staleness_limit_h": {
          "type": "integer",
          "minimum": 1
        },
        "min_evidence_coverage_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "settlement_band_pct": {
          "type": "object",
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "agent_call_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "decision_rights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "priority",
          "conditions",
          "outcome",
          "required_roles"
        ],
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^DR-[0-9]{2,4}$"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "description": "All present conditions must hold for the rule to match.",
            "properties": {
              "action_types": {
                "type": "array",
                "items": {
                  "$ref": "common.json#/$defs/action_type"
                },
                "uniqueItems": true
              },
              "decision_points": {
                "type": "array",
                "items": {
                  "$ref": "common.json#/$defs/decision_point"
                },
                "uniqueItems": true
              },
              "decider_kinds": {
                "type": "array",
                "items": {
                  "$ref": "common.json#/$defs/decider_kind"
                },
                "uniqueItems": true
              },
              "min_value_usd": {
                "$ref": "common.json#/$defs/usd"
              },
              "max_value_usd": {
                "$ref": "common.json#/$defs/usd"
              },
              "customer_tiers": {
                "type": "array",
                "items": {
                  "$ref": "common.json#/$defs/customer_tier"
                },
                "uniqueItems": true
              },
              "food_safety_flag": {
                "type": "boolean"
              },
              "min_confidence": {
                "$ref": "common.json#/$defs/confidence"
              }
            }
          },
          "outcome": {
            "$ref": "common.json#/$defs/policy_outcome"
          },
          "required_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^BBC_[A-Z_]+$"
            },
            "uniqueItems": true
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "router_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "trigger",
          "enabled",
          "target_agent"
        ],
        "additionalProperties": false,
        "properties": {
          "trigger": {
            "$ref": "common.json#/$defs/escalation_reason"
          },
          "enabled": {
            "type": "boolean"
          },
          "target_agent": {
            "enum": [
              "EXCURSION_FORENSICS",
              "RECOVERY_STRATEGIST",
              "CLAIMS_RECOVERY"
            ]
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "hard_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "limit_id",
          "product_id",
          "max_pulp_c",
          "max_minutes_above",
          "consequence"
        ],
        "additionalProperties": false,
        "properties": {
          "limit_id": {
            "type": "string",
            "pattern": "^HL-[0-9]{2,4}$"
          },
          "product_id": {
            "oneOf": [
              {
                "$ref": "common.json#/$defs/external_id"
              },
              {
                "const": "*"
              }
            ]
          },
          "max_pulp_c": {
            "$ref": "common.json#/$defs/celsius"
          },
          "max_minutes_above": {
            "type": "integer",
            "minimum": 0
          },
          "consequence": {
            "enum": [
              "INSPECT_HOLD_OR_DISPOSE_ONLY"
            ]
          }
        }
      }
    },
    "autonomy_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "financial",
        "customer",
        "inventory",
        "operational",
        "confidence",
        "data_quality"
      ],
      "properties": {
        "financial": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric",
              "l3_max",
              "l4_max"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "l3_max": {
                "type": [
                  "number",
                  "boolean",
                  "string"
                ]
              },
              "l4_max": {
                "type": [
                  "number",
                  "boolean",
                  "string",
                  "null"
                ]
              },
              "beyond_l4": {
                "enum": [
                  "DUAL_APPROVAL",
                  "L2",
                  "L1",
                  "FALLBACK_ONLY"
                ]
              },
              "approver_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^BBC_[A-Z_]+$"
                }
              }
            }
          }
        },
        "customer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric",
              "l3_max",
              "l4_max"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "l3_max": {
                "type": [
                  "number",
                  "boolean",
                  "string"
                ]
              },
              "l4_max": {
                "type": [
                  "number",
                  "boolean",
                  "string",
                  "null"
                ]
              },
              "beyond_l4": {
                "enum": [
                  "DUAL_APPROVAL",
                  "L2",
                  "L1",
                  "FALLBACK_ONLY"
                ]
              },
              "approver_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^BBC_[A-Z_]+$"
                }
              }
            }
          }
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric",
              "l3_max",
              "l4_max"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "l3_max": {
                "type": [
                  "number",
                  "boolean",
                  "string"
                ]
              },
              "l4_max": {
                "type": [
                  "number",
                  "boolean",
                  "string",
                  "null"
                ]
              },
              "beyond_l4": {
                "enum": [
                  "DUAL_APPROVAL",
                  "L2",
                  "L1",
                  "FALLBACK_ONLY"
                ]
              },
              "approver_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^BBC_[A-Z_]+$"
                }
              }
            }
          }
        },
        "operational": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric",
              "l3_max",
              "l4_max"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "l3_max": {
                "type": [
                  "number",
                  "boolean",
                  "string"
                ]
              },
              "l4_max": {
                "type": [
                  "number",
                  "boolean",
                  "string",
                  "null"
                ]
              },
              "beyond_l4": {
                "enum": [
                  "DUAL_APPROVAL",
                  "L2",
                  "L1",
                  "FALLBACK_ONLY"
                ]
              },
              "approver_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^BBC_[A-Z_]+$"
                }
              }
            }
          }
        },
        "confidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric",
              "l3_max",
              "l4_max"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "l3_max": {
                "type": [
                  "number",
                  "boolean",
                  "string"
                ]
              },
              "l4_max": {
                "type": [
                  "number",
                  "boolean",
                  "string",
                  "null"
                ]
              },
              "beyond_l4": {
                "enum": [
                  "DUAL_APPROVAL",
                  "L2",
                  "L1",
                  "FALLBACK_ONLY"
                ]
              },
              "approver_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^BBC_[A-Z_]+$"
                }
              }
            }
          }
        },
        "data_quality": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric",
              "l3_max",
              "l4_max"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "l3_max": {
                "type": [
                  "number",
                  "boolean",
                  "string"
                ]
              },
              "l4_max": {
                "type": [
                  "number",
                  "boolean",
                  "string",
                  "null"
                ]
              },
              "beyond_l4": {
                "enum": [
                  "DUAL_APPROVAL",
                  "L2",
                  "L1",
                  "FALLBACK_ONLY"
                ]
              },
              "approver_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^BBC_[A-Z_]+$"
                }
              }
            }
          }
        }
      }
    },
    "action_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_type",
          "target_system",
          "reversibility",
          "max_level",
          "compensation"
        ],
        "additionalProperties": false,
        "properties": {
          "action_type": {
            "$ref": "common.json#/$defs/action_type"
          },
          "target_system": {
            "$ref": "common.json#/$defs/target_system"
          },
          "reversibility": {
            "$ref": "common.json#/$defs/reversibility"
          },
          "max_level": {
            "$ref": "common.json#/$defs/autonomy_level"
          },
          "compensation": {
            "oneOf": [
              {
                "$ref": "common.json#/$defs/action_type"
              },
              {
                "type": "null"
              }
            ]
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "model_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "agent",
          "provider",
          "model",
          "role",
          "data_classes"
        ],
        "additionalProperties": false,
        "properties": {
          "agent": {
            "enum": [
              "EXCURSION_FORENSICS",
              "RECOVERY_STRATEGIST",
              "CLAIMS_RECOVERY",
              "EVIDENCE_AUDITOR"
            ]
          },
          "provider": {
            "enum": [
              "CORTEX",
              "ANTHROPIC",
              "OPENAI_COMPATIBLE"
            ]
          },
          "model": {
            "type": "string",
            "maxLength": 64
          },
          "role": {
            "enum": [
              "PRIMARY",
              "FALLBACK"
            ]
          },
          "data_classes": {
            "type": "array",
            "items": {
              "enum": [
                "OPERATIONAL",
                "COMMERCIAL",
                "CONTRACTUAL"
              ]
            },
            "uniqueItems": true
          },
          "must_differ_from_author": {
            "type": "boolean"
          }
        }
      }
    },
    "metric_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "canonical",
          "unit",
          "grain",
          "owner_role"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "version": {
            "$ref": "common.json#/$defs/version"
          },
          "canonical": {
            "type": "boolean"
          },
          "unit": {
            "type": "string",
            "maxLength": 32
          },
          "grain": {
            "type": "string",
            "maxLength": 64
          },
          "owner_role": {
            "type": "string",
            "pattern": "^BBC_[A-Z_]+$"
          },
          "staleness_limit_min": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "allowed_dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definition_hash": {
            "$ref": "common.json#/$defs/sha256",
            "description": "Hash of the metric's definition in the semantic model (blueberrychain.semantic.definition_hashes)."
          }
        }
      }
    }
  }
}
