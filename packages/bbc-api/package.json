{
  "name": "@blueberrychain/bbc-api",
  "version": "0.1.0",
  "description": "Typed port onto the approved BlueberryChain OS Snowflake interfaces (API procedures and views), with a logic-free fixture player",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tapes": "node scripts/build-tapes.mjs"
  },
  "dependencies": {
    "@blueberrychain/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
